# Supabase (optional: omit both to run in local demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional feature gates (keep unset/false in Production until verified)
VITE_ENABLE_SAFE_CLIENT_DELETE=
VITE_ENABLE_TEST_CLIENT=

# Gemini API (server-side only)
GEMINI_API_KEY=

# AI Studio dev server options
DISABLE_HMR=
